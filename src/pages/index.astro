<script is:inline>
  // Keep the time readout locked to the CSS progress animation.
  (function () {
    var fill = document.querySelector('.bar i'), t = document.querySelector('.time');
    var anim = fill && fill.getAnimations && fill.getAnimations()[0];
    if (!anim) return;
    setInterval(function () {
      var s = Math.floor((Number(anim.currentTime) % 14000) / 1000);
      t.textContent = '0:' + String(s).padStart(2, '0') + ' / 0:14';
    }, 250);
  })();
</script>
