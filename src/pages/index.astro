---
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '@fontsource/geist-mono/600.css';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Munrhalls</title>
<!-- v1.52: strip copy — "store"→"platform", "Professional features"→"Shipped features" -->
<!-- v1.53: CTA diamond — glyphs knocked out behind the arrow so the arrowhead reads -->
<!-- v1.54: CONTACT hover/focus — text, outline and glyphs go amber + soft amber halo (was a 1px cream→amber stroke swap, near-invisible) -->
<!-- v1.55: skills line — full --muted (was .8 opacity, 4.95:1 → 7.2:1); intro+CONTACT up 3u so the gap above the strip goes 5.5u → ~10.5u -->
<!-- v1.56: nav diamond glyphs .68 → .42 so the amber CTA owns the bottom half -->
<!-- v1.57: stats from the repo — 1 Engineer · 24 Months · 17 Features · 650+ Products; strip spread edge to edge, links to the public repo -->
<!-- v1.58: smallest text (skills line, strip kind, stat labels) 9–9.5u → 10u so it clears 12px on 360-wide phones -->
<!-- v1.59: H1 15u → 17u (still two lines); intro + CONTACT up 3u to pay for it -->
<!-- v1.60: code diamonds + katakana indigo → amber, luminance-matched so the brightness hierarchy is unchanged (asset: code-diamond-black-bg.amber.png; --ambient #8a91f2 → #ba943e; CONTACT glow likewise) -->
<!-- v1.61: bottom gradient navy → warm black (same brightness). 40% of the nav-diamond pixels were blue-tinted: the navy showed through the diamond's dark areas under the screen blend, so the amber read as repainted over blue. Now 0% -->
<!-- v1.62: nav diamond → four full-width bands (Features · Case studies · Learning · Story), 30u tall, bottom-anchored; SEE IT LIVE shrinks to 0.82× and moves up under the video; video gives up the height (flat bands only — texture and hand come in later rounds) -->
<!-- v1.63: bands out; open-palm hand outline in (traced from a real photo silhouette, stroke only, transparent, arm bleeds off the right edge). Veins/labels next -->
<!-- v1.64: hand mirrored horizontally — arm now enters from the left edge, fingers reach right (fingertips end on the video's right edge) -->
<!-- v1.65: hand drops to the bottom edge (arm bleeds off left + bottom, fingers reach up toward the buttons); four buttons (2×2) take the freed space under SEE IT LIVE -->
<!-- v1.66: buttons → pure text (no box/border/fill), loosely staggered, floating above the hand; hand shifted 100u left so only the fingers enter the frame -->
<!-- v1.67: all four texts gathered into the left cluster above the hand (2 cascading rows), clear of SEE IT LIVE -->
<!-- v1.68: outline hand → engraved hand (ink-on-white PNG inverted to warm light ink on transparent, design/hand-engraving.webp); arm bleeds off the left, fingers reach right under the text. PLACEHOLDER ART — source looks like a Shutterstock preview, license before shipping -->
<!-- v1.69: hand → bottom-left corner (320u→290u wide, 62u off the left edge, 75u above the bottom) to free the band between palm and labels for the code streams -->
<!-- v1.70: katakana code streams fan out of the palm to the four texts (as in the sketch: Story far left, Case studies up-left, Features up-right, Learning far right); the texts spread into an arc so each stream has clear air; depth = glyph size + brightness; static pass -->
<!-- v1.71: streams lift steeply off the palm before bending out (no flat runs across the hand), 5 per text, soft amber glow at the palm, slow brightness pulses travel palm→text (reduced-motion: static) -->
<!-- v1.72: four texts → sentence case (Features · Case studies · Learning · Story), 10u → 9.4u, and 12–14u closer to the hand; streams re-aimed at the new positions -->
<!-- v1.73: main diamond mask — the hard seam at 51.6% height (left side dimmed above, full below) was a visible straight edge cutting the katakana columns near SEE IT LIVE; now a smooth ramp over 20%→51.6%, identical below the old seam -->
<!-- v1.74: streams all leave ONE point in the palm and skim over the fingertips on the way to the texts; hand silhouette is now solid dark (hand-engraving-solid.webp) so far streams (back layer) disappear behind the hand/fingers and near streams (front layer) float over it = depth -->
<!-- v1.75: streams re-built as braided ribbons (3 twisting katakana strands; near strand bigger/brighter = 3D) that START at the named parts of the hand — Learning ← index finger, Features ← the three free fingers (3 strands, one per tip), Case studies + Story ← palm mouth — and never cross a finger; single layer above the hand -->
<!-- v1.76: Case studies up 26u + left 26u, Features up 24u + left 17u; every stream group is now an ARRAY (5–7 strands) that starts wide at its source (palm / finger tips) and concentrates, thinning (spread, twist and glyph size all taper) toward the center point of its text -->
<!-- v1.77: Case studies + Story streams now start at the CENTER of the palm and sweep up over the thumb (the thumb sits behind the streams in the 3D read); Features/Learning unchanged -->
<!-- v1.78: Features text moved 31u left + 12u down (to the "here" mark); its three-finger stream array re-aimed at the new center point -->
<!-- v1.78p: design height 400u → 481u (real phones are 440–570u; 400 had zero slack). Video = the one elastic element, capped at 16:9 (167u tall, was 88u); stat numbers 11u → 13u so type steps are equal ratios 17 : 13 : 10 (≈1.3 each); strip +2.2u; surplus above 481u → 50% over the intro, 25% per group gap. Gap series left as is (ink gaps 10 / 6 / 13 already group correctly) -->
<!-- v1.78p: "E-commerce" → "E-commerce app" -->
<!-- v1.78o: nav labels 9.4u → 10u (clears the 12px floor from v1.58) and weight 500 → 600; tracking .04em → 0 so every label keeps its exact width — rhombi, streams and left margin do not move -->
<!-- v1.78p: "E-commerce" → "E-commerce app" -->
<!-- v1.78o: responsive frame — frame = viewport width (capped at 3:4 so height ≥ 400u), --hu = 300·H/W; same u-scaling, so the floor 280×380 (407u) fits with no per-element changes; fixed 300×481 kept as fallback -->
<!-- v1.78n: "E-commerce" back (a stranger can't tell what SANGLOGIUM.COM is without it; "platform" dropped to keep the row airy); strip +5u taller and 3u lower so text has ~8u above and below inside the band and the skills line clears its top edge; video + Case studies chip 8u lower to pay for it -->
<!-- v1.78m: strip de-cramped — "E-commerce platform" deleted (the name, the stats and the video already say it); LIVE + rhombus pushed to the right margin, flush with the stats column edge; name row and stats get 1.5u more air -->
<!-- v1.78l: CTA "SEE IT LIVE" → "LIVE" + rhombus, moved into the title strip between SANGLOGIUM.COM and "E-commerce platform"; rail/underline removed, amber kept, sized to the strip row (9u text, 14u rhombus) -->
<!-- v1.78k: rail is now drawn inside the rhombus svg, one line with the arrow shaft (no more separate underline to drift off by a pixel) -->
<!-- v1.78j: rail centred on the rhombus arrow's line (was 0.5px high) -->
<!-- v1.78i: every stream now arrives dead vertical and centred under its rhombus tip (was angled in from the side) -->
<!-- v1.78h: chips: no fill shape or border (soft white cloud, ~10%), rhombus redrawn as the CTA's (open corners, glyph columns knocked out, rail becomes the arrow through it), all white -->
<!-- v1.78g: chips all white, rail runs through an arrowhead into a rhombus holding code-stream glyphs (CONTACT/CTA language); streams now end at the rhombi; chips re-placed (Case studies 22u left, Features right, Learning right) so no stream crosses a chip -->
<!-- v1.78f: labels become chips (faint copper wash, hairline rail fading in from the left, chevron — CTA language); streams rebuilt by gen-streams.py: one braided spindle per fingertip → chip (gap off the finger, swells, converges to a point on the chip); Story←thumb, Case studies←2nd, Features←middle pair, Learning←outer finger -->
<!-- v1.78e: Learning text 36u left; its streams re-aimed so glyph spacing matches the other streams (no gaps) -->
<!-- v1.78d: hand 20% smaller (290u→232u wide), scaled toward the bottom-left corner; stream hand ends follow, text ends stay -->
<!-- v1.78c: hand 24u higher (more of palm/fingers visible); each stream's hand end rides up with it, text end stays put -->
<!-- v1.78b: hand → prepared line-art hand (design/hand-isolated.png, 870×350) over a generated dark silhouette underlay (hand-isolated-solid.webp), same slot/size; streams untouched -->
<style is:global>
  :root{
    --bg:#14120f; --text:#ece6da; --muted:#a89f92; --amber:#e6b84f; --ambient:#ba943e; --sink:#0a0908; --raise:#1c1915;
    --line:#2c271e; --line2:#403b31; --rule:#6a6252;
    /* design height 481u = typical phone in-browser (real range ≈ 440–570u; 400 = floor). Video is the one elastic element: it flexes with height up to 16:9 (167u); any surplus beyond that goes 50% above the intro, 25% into each group gap. Nav+hand are bottom-anchored. */
    --hu:481; --e:calc(min(max(var(--hu),400),650) - 400);
    --x:calc(max(0, var(--e) - 81.2)); --s:calc(var(--x)*.5); --g:calc(var(--x)*.25);
    --M:calc(min(167, 85.8 + var(--e) - var(--s) - 2*var(--g)));
    --sans:'Geist',system-ui,-apple-system,'Segoe UI',sans-serif;
    --mono:'Geist Mono',ui-monospace,'SF Mono',Menlo,Consolas,monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  body{background:#0a0908;display:grid;place-items:center;font-family:var(--sans);color:var(--text)}

  /* Frame: 300×400 design size. --u = 1px at 300 wide; every dimension below is N×u,
     so the whole screen scales with the frame width. */
  .frame{width:300px;height:calc(var(--hu)*1px);position:relative;overflow:hidden;background:var(--bg);
         container-type:size;isolation:isolate}
  .stage{position:absolute;inset:0;--u:calc(100cqw / 300)}
  /* Responsive: frame fills the viewport (width capped so height ≥ 400u), design height = 300·H/W in u. */
  @supports (z-index:calc(1px / 1px)){
    :root{--hu:max(400, calc(300 * 100dvh / 100vw))}
    .frame{width:min(100vw,75dvh);height:100dvh}
  }
  a{color:inherit;text-decoration:none}

  /* ── Background gradients: top light→dark (L→R), bottom dark→light (L→R) ── */
  .bg{position:absolute;left:0;right:0;z-index:0;pointer-events:none}
  .bg.t{top:0;height:calc((150 + var(--s))*var(--u));background:linear-gradient(to right,#27231c,#0a0908);
        -webkit-mask-image:linear-gradient(#000 55%,transparent);mask-image:linear-gradient(#000 55%,transparent)}
  .bg.b{top:calc((250 + var(--e))*var(--u));bottom:0;background:linear-gradient(to right,#030302,#130f0a);
        -webkit-mask-image:linear-gradient(transparent,#000 30%);mask-image:linear-gradient(transparent,#000 30%)}
  /* ── Main code diamond: ambient, top-right, bleeds off the edge, not clickable ── */
  .dm{position:absolute;z-index:0;pointer-events:none;
      left:calc(77*var(--u));top:calc((84 + var(--e))*var(--u));width:calc(380*var(--u));height:calc(380*var(--u));
      mix-blend-mode:screen;               /* black pixels add no light → box disappears */
      -webkit-mask-image:linear-gradient(to bottom left,#000 35%,rgba(0,0,0,.45) 85%),linear-gradient(to right,rgba(0,0,0,.2) 54.2%,#000 59.2%),linear-gradient(to bottom,transparent 20%,rgba(0,0,0,.1) 28%,rgba(0,0,0,.35) 36%,rgba(0,0,0,.75) 44%,#000 51.6%);
      -webkit-mask-size:100% 100%,100% 100%,100% 100%;-webkit-mask-position:0 0,0 0,0 0;-webkit-mask-repeat:no-repeat;
      -webkit-mask-composite:source-in,source-over;
              mask-image:linear-gradient(to bottom left,#000 35%,rgba(0,0,0,.45) 85%),linear-gradient(to right,rgba(0,0,0,.2) 54.2%,#000 59.2%),linear-gradient(to bottom,transparent 20%,rgba(0,0,0,.1) 28%,rgba(0,0,0,.35) 36%,rgba(0,0,0,.75) 44%,#000 51.6%);
              mask-size:100% 100%,100% 100%,100% 100%;mask-position:0 0,0 0,0 0;mask-repeat:no-repeat;
              mask-composite:intersect,add}
  .dm img{display:block;width:100%;height:100%;opacity:.5}
  @keyframes drift{
    from{transform:translate(0,0) scale(1);opacity:.45}
    to  {transform:translate(calc(-3*var(--u)),calc(4*var(--u))) scale(1.02);opacity:.55}
  }

  .cglow{position:absolute;z-index:1;pointer-events:none;left:calc(233*var(--u));top:calc((-17 + var(--s))*var(--u));
         width:calc(70*var(--u));height:calc(70*var(--u));
         background:radial-gradient(circle,rgba(186,148,62,.38) 0,rgba(186,148,62,.15) 42%,transparent 70%)}
  /* ── 2 Intro ── */
  .intro{position:absolute;z-index:2;left:calc(18*var(--u));top:calc((10 + var(--s))*var(--u));width:calc(240*var(--u))}
  .contact{position:absolute;z-index:3;right:calc(18*var(--u));top:calc((4 + var(--s))*var(--u));height:calc(28*var(--u));
           display:flex;align-items:center;gap:0;color:var(--text);
           font:600 calc(9*var(--u))/1 var(--mono);letter-spacing:.14em}
  .contact .t{position:relative;z-index:1;transition:color .15s}
  .contact svg{width:calc(28*var(--u));height:calc(28*var(--u));overflow:visible;flex:none;margin-left:calc(-16.9*var(--u));transition:filter .15s}
  .contact .cg{fill:var(--ambient);transition:fill .15s}
  .contact svg polyline{fill:none;stroke:var(--text);stroke-width:1;stroke-linejoin:miter;vector-effect:non-scaling-stroke;transition:stroke .15s}
  .contact:hover svg polyline,.contact:focus-visible svg polyline{stroke:var(--amber)}
  .contact:hover .t,.contact:focus-visible .t{color:var(--amber)}
  .contact:hover .cg,.contact:focus-visible .cg{fill:var(--amber)}
  .contact:hover svg,.contact:focus-visible svg{filter:drop-shadow(0 0 calc(2.5*var(--u)) rgba(230,184,79,.95))}
  .contact:focus-visible{outline:none}
  .intro .hi{display:block;font:500 calc(12*var(--u))/1.3 var(--sans);color:var(--text);margin-bottom:calc(4*var(--u))}
  .intro .skills{display:block;margin-top:calc(6*var(--u));width:calc(264*var(--u));white-space:nowrap;font:400 calc(10*var(--u))/1 var(--sans);letter-spacing:.01em;color:var(--muted)}
  .intro .skills i{font-style:normal;color:var(--muted);opacity:.55;padding:0 calc(2*var(--u))}
  .intro h1{margin:0;font:700 calc(17*var(--u))/1.18 var(--sans);letter-spacing:-.01em;text-wrap:balance}

  /* ── 3 Black title strip ── */
  .strip{position:absolute;z-index:2;left:0;right:0;top:calc((97 + var(--s) + var(--g))*var(--u));height:calc(55.2*var(--u));
         background:rgba(10,9,8,.8);padding:0 calc(18*var(--u));
         display:flex;flex-direction:column;justify-content:center;gap:calc(4.5*var(--u));font-family:var(--mono)}
  .strip .top{display:flex;justify-content:flex-start;align-items:baseline;gap:calc(7*var(--u))}
  .strip .site{font-size:calc(11*var(--u));line-height:1.1;font-weight:600;letter-spacing:.04em;color:var(--text)}
  .strip .kind{font-size:calc(10*var(--u));letter-spacing:0;color:var(--muted)}
  .strip .stats{display:grid;grid-template-columns:repeat(4,auto);justify-content:space-between}
    .strip .stats b{display:block;font-weight:600;font-size:calc(13*var(--u));line-height:1.1;color:#c9c1b2}
  .strip .stats span{display:block;margin-top:calc(1.5*var(--u));font-size:calc(10*var(--u));letter-spacing:0;color:var(--muted);white-space:nowrap}

  /* ── 5 Movie: 16:9 autoplaying muted inline video (simulated) ── */
  .movie{position:absolute;z-index:2;left:calc(18*var(--u));top:calc((158.2 + var(--s) + var(--g))*var(--u));
         width:calc(264*var(--u));height:calc(var(--M)*var(--u));border-radius:calc(3*var(--u));overflow:hidden;
         background:var(--sink);border:1px solid var(--rule)}
  .screen{position:absolute;inset:0}
  .m-top{position:absolute;left:0;right:0;top:0;height:13%;background:var(--raise);border-bottom:1px solid var(--line);
         display:flex;align-items:center;justify-content:space-between;padding:0 4%}
  .m-top i{display:block;height:28%;background:var(--muted);width:20%}
  .m-top span{display:flex;gap:calc(5*var(--u))}
  .m-top span s{display:block;width:calc(14*var(--u));height:calc(2*var(--u));background:var(--line2)}
  .grid{position:absolute;left:4%;right:4%;top:17%;bottom:19%;display:grid;
        grid-template-columns:repeat(4,1fr);grid-template-rows:repeat(2,1fr);gap:4% 3%}
  .card{background:var(--raise);border:1px solid var(--line);border-radius:calc(2*var(--u));padding:6%;
        display:flex;flex-direction:column;gap:6%}
  .card u{display:block;flex:1;background:var(--line);border-radius:1px}
  .card s{display:block;height:calc(2.2*var(--u));background:var(--line2);width:80%}
  .card s+s{width:45%;background:var(--line)}
  .card:nth-child(2){animation:pick1 14s infinite}
  .card:nth-child(7){animation:pick2 14s infinite}
  @keyframes pick1{0%,9%{border-color:var(--line)}12%,36%{border-color:var(--muted)}40%,100%{border-color:var(--line)}}
  @keyframes pick2{0%,47%{border-color:var(--line)}50%,72%{border-color:var(--muted)}76%,100%{border-color:var(--line)}}
  .cur{position:absolute;width:calc(7*var(--u));left:92%;top:18%;animation:cur 14s ease-in-out infinite}
  .cur svg{display:block;width:100%;height:auto}
  @keyframes cur{
    0%{left:92%;top:18%} 12%,36%{left:36%;top:33%}
    50%,72%{left:60%;top:69%} 90%,100%{left:92%;top:18%}
  }
  /* player chrome — progress is the “this is playing” signal; no play button */
  .ctl{position:absolute;left:0;right:0;bottom:0;height:calc(15*var(--u));background:rgba(10,9,8,.85);
       display:flex;align-items:center;justify-content:space-between;padding:0 calc(7*var(--u))}
  .time{font:500 calc(8*var(--u))/1 var(--mono);color:var(--muted);font-variant-numeric:tabular-nums}
  .ctl svg{width:calc(9*var(--u));height:calc(9*var(--u));stroke:var(--muted);fill:none;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
  .bar{position:absolute;left:0;right:0;bottom:calc(15*var(--u));height:calc(2.5*var(--u));background:var(--line2)}
  .bar i{display:block;height:100%;width:0;background:var(--text);animation:prog 14s linear infinite}
  @keyframes prog{to{width:100%}}

  /* ── 6a Buttons: 2×2, between SEE IT LIVE and the hand ── */
  .btns{position:absolute;z-index:4;left:0;width:calc(300*var(--u));height:calc(74*var(--u));top:calc((400 + var(--e) - 150)*var(--u))}
  .btn{position:absolute;height:calc(20*var(--u));display:flex;align-items:center;gap:calc(5*var(--u));padding:0 0 0 calc(9*var(--u));
       color:var(--text);font:600 calc(10*var(--u))/1 var(--mono);letter-spacing:0;white-space:nowrap;transition:color .15s;
       background:radial-gradient(ellipse closest-side at 45% 55%,rgba(255,255,255,.10),rgba(255,255,255,0))}   /* soft cloud, no edge, no border */
  /* CTA language, all white: hairline rail fades in from the left and becomes the arrow through a code-glyph rhombus */
  .btn .nd{flex:none;align-self:flex-end;margin-bottom:calc(-7.5*var(--u));width:calc(16*var(--u));height:calc(16*var(--u));overflow:visible;fill:none;stroke:currentColor;stroke-width:1;stroke-linejoin:miter}
  .btn .nd *{vector-effect:non-scaling-stroke}
  .btn .nd .kg{fill:currentColor;stroke:none;opacity:.55;font-family:var(--mono)}
  .btn:nth-child(1){left:calc(124*var(--u));top:calc(8*var(--u))}    /* Features  */
  .btn:nth-child(2){left:calc(8*var(--u));top:calc(4*var(--u))}     /* Case studies */
  .btn:nth-child(3){left:calc(196*var(--u));top:calc(42*var(--u))}   /* Learning  */
  .btn:nth-child(4){left:calc(10*var(--u));top:calc(36*var(--u))}    /* Story     */
  .btn:hover,.btn:focus-visible{outline:none;color:var(--amber)}

  /* ── 6c Code streams (behind the hand and the labels) ── */
  .streams{position:absolute;z-index:1;left:0;width:calc(300*var(--u));height:calc(170*var(--u));top:calc((400 + var(--e) - 170)*var(--u));overflow:visible;pointer-events:none}
  .streams .g{fill:var(--muted);opacity:var(--o);text-anchor:middle;dominant-baseline:central;font-family:var(--mono),'Noto Sans CJK JP','Noto Sans JP','Hiragino Sans','Yu Gothic',sans-serif}
  .streams.f{z-index:3}
  @keyframes pulse{0%{opacity:var(--o)}10%{opacity:min(1,calc(var(--o)*2.1))}38%,100%{opacity:calc(var(--o)*.55)}}
  .streams .g{animation:pulse var(--p) linear infinite;animation-delay:var(--d)}
  .pglow{position:absolute;z-index:1;pointer-events:none;left:calc(98*var(--u));top:calc((400 + var(--e) - 90)*var(--u));width:calc(84*var(--u));height:calc(70*var(--u));
         background:radial-gradient(ellipse at 50% 55%,rgba(186,148,62,.20),rgba(186,148,62,.07) 45%,transparent 70%)}

  /* ── 6b Hand: engraved art, light ink on transparent; arm bleeds off the left edge (H' = 400 + e) ── */
  .hand{position:absolute;z-index:2;left:calc(-49.6*var(--u));width:calc(232*var(--u));top:calc((400 + var(--e) - 79.1)*var(--u));
        display:block;height:auto;pointer-events:none;opacity:.92}

  /* ── 7 CTA: "LIVE" + rhombus, inline in the title strip between the site name and its kind ── */
  .strip .top{gap:calc(7*var(--u));align-items:center}
  .strip .top .cta{margin-left:auto}
  .cta{display:inline-flex;align-items:center;gap:calc(2*var(--u));color:var(--amber);font:600 calc(9*var(--u))/1 var(--mono);letter-spacing:.08em;transition:filter .15s}
  .cta .nd2{flex:none;width:calc(14*var(--u));height:calc(14*var(--u));margin:calc(-3*var(--u)) 0;overflow:visible;fill:none;stroke:currentColor;stroke-width:1;stroke-linejoin:miter}
  .cta .nd2 *{vector-effect:non-scaling-stroke}
  .cta .nd2 .kg{fill:currentColor;stroke:none;opacity:.55;font-family:var(--mono)}
  .cta:hover,.cta:focus-visible{outline:none;filter:drop-shadow(0 0 calc(2.5*var(--u)) rgba(230,184,79,.9))}

  @media (prefers-reduced-motion:reduce){
    *{animation:none!important}
    .bar i{width:38%}
  }
</style>
</head>
<body>
<main class="frame">
  <div class="stage">

    <div class="bg t" aria-hidden="true"></div><div class="bg b" aria-hidden="true"></div>
    <!-- 4 Main diamond (decorative, not clickable) -->
    <div class="dm" aria-hidden="true"><img src="/images/code-diamond-black-bg.amber.png" alt=""></div>

