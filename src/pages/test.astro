---
import '../styles/tailwind.css';
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '@fontsource/geist-mono/600.css';
---
<!doctype html>
<html lang="en" class="h-full">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Munrhalls — token test</title>
<!-- Token test page: same markup as index.astro, styled only through tailwind.config.ts tokens. No <style> block. -->
</head>
<body class="grid h-full place-items-center bg-surface-sink font-sans text-ink">
<main class="frame container-size relative isolate h-frame w-frame overflow-hidden bg-surface-base">
  <div class="stage u-root absolute inset-0">

    <div class="bg t pointer-events-none absolute inset-x-0 top-0 z-0 h-anchor-wash-top bg-wash-top mask-fade-down" aria-hidden="true"></div><div class="bg b pointer-events-none absolute inset-x-0 bottom-0 top-anchor-wash-bottom z-0 bg-wash-bottom mask-fade-up" aria-hidden="true"></div>
    <!-- 4 Main diamond (decorative, not clickable) -->
    <div class="dm pointer-events-none absolute left-77 top-anchor-diamond z-0 h-380 w-380 mix-blend-screen mask-diamond" aria-hidden="true"><img class="block h-full w-full opacity-50" src="/images/code-diamond-black-bg.amber.png" alt=""></div>

    <!-- 2 Intro -->
    <div class="cglow pointer-events-none absolute left-233 top-anchor-glow-contact z-1 h-70 w-70 bg-glow-contact" aria-hidden="true"></div>
    <a class="contact group absolute right-18 top-anchor-contact z-3 flex h-28 items-center gap-0 font-mono text-xs font-semibold leading-solid tracking-widest text-ink hover:text-amber focus-visible:text-amber focus-visible:outline-none" href="#contact"><span class="t relative z-1 transition-color">CONTACT</span><svg class="-ml-16.9 h-28 w-28 flex-none overflow-visible transition-filter group-hover:drop-shadow-glow-contact group-focus-visible:drop-shadow-glow-contact" viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="rg" gradientUnits="userSpaceOnUse" x1="7" y1="0" x2="16" y2="0"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset="1" stop-color="#fff" stop-opacity="1"/></linearGradient><mask id="rm" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24"><rect width="24" height="24" fill="url(#rg)"/></mask><clipPath id="rc"><polygon points="5.8,6.7 12,0.5 23.5,12 12,23.5 5.8,17.3"/></clipPath></defs><g clip-path="url(#rc)" mask="url(#rm)" font-size="2.6" class="cg fill-amber-ambient transition-fill group-hover:fill-amber group-focus-visible:fill-amber" font-family="'Geist Mono',monospace" text-anchor="middle"><text y="1.8" opacity="0.55"><tspan x="5.2" dy="0">ナ</tspan><tspan x="5.2" dy="2.9">コ</tspan><tspan x="5.2" dy="2.9">ハ</tspan><tspan x="5.2" dy="2.9">レ</tspan><tspan x="5.2" dy="2.9">エ</tspan><tspan x="5.2" dy="2.9">オ</tspan><tspan x="5.2" dy="2.9">モ</tspan><tspan x="5.2" dy="2.9">キ</tspan></text><text y="1.8" opacity="0.3"><tspan x="7.9" dy="0">ネ</tspan><tspan x="7.9" dy="2.9">ヨ</tspan><tspan x="7.9" dy="2.9">エ</tspan><tspan x="7.9" dy="2.9">ム</tspan><tspan x="7.9" dy="2.9">セ</tspan><tspan x="7.9" dy="2.9">ウ</tspan><tspan x="7.9" dy="2.9">カ</tspan><tspan x="7.9" dy="2.9">フ</tspan></text><text y="1.8" opacity="0.7"><tspan x="10.6" dy="0">ヒ</tspan><tspan x="10.6" dy="2.9">オ</tspan><tspan x="10.6" dy="2.9">タ</tspan><tspan x="10.6" dy="2.9">カ</tspan><tspan x="10.6" dy="2.9">ヤ</tspan><tspan x="10.6" dy="2.9">フ</tspan><tspan x="10.6" dy="2.9">エ</tspan><tspan x="10.6" dy="2.9">ユ</tspan></text><text y="1.8" opacity="0.4"><tspan x="13.3" dy="0">ク</tspan><tspan x="13.3" dy="2.9">ソ</tspan><tspan x="13.3" dy="2.9">ル</tspan><tspan x="13.3" dy="2.9">ル</tspan><tspan x="13.3" dy="2.9">ヨ</tspan><tspan x="13.3" dy="2.9">エ</tspan><tspan x="13.3" dy="2.9">ユ</tspan><tspan x="13.3" dy="2.9">ヨ</tspan></text><text y="1.8" opacity="0.55"><tspan x="16.0" dy="0">ハ</tspan><tspan x="16.0" dy="2.9">エ</tspan><tspan x="16.0" dy="2.9">ソ</tspan><tspan x="16.0" dy="2.9">ウ</tspan><tspan x="16.0" dy="2.9">ヤ</tspan><tspan x="16.0" dy="2.9">ケ</tspan><tspan x="16.0" dy="2.9">テ</tspan><tspan x="16.0" dy="2.9">ヒ</tspan></text><text y="1.8" opacity="0.3"><tspan x="18.7" dy="0">コ</tspan><tspan x="18.7" dy="2.9">モ</tspan><tspan x="18.7" dy="2.9">ク</tspan><tspan x="18.7" dy="2.9">ユ</tspan><tspan x="18.7" dy="2.9">ト</tspan><tspan x="18.7" dy="2.9">ヤ</tspan><tspan x="18.7" dy="2.9">ワ</tspan><tspan x="18.7" dy="2.9">シ</tspan></text><text y="1.8" opacity="0.7"><tspan x="21.4" dy="0">キ</tspan><tspan x="21.4" dy="2.9">ヨ</tspan><tspan x="21.4" dy="2.9">ユ</tspan><tspan x="21.4" dy="2.9">ル</tspan><tspan x="21.4" dy="2.9">ス</tspan><tspan x="21.4" dy="2.9">ネ</tspan><tspan x="21.4" dy="2.9">キ</tspan><tspan x="21.4" dy="2.9">ヤ</tspan></text></g><polyline class="fill-none stroke-ink stroke-1 stroke-join-miter svg-vector-fixed transition-stroke group-hover:stroke-amber group-focus-visible:stroke-amber" points="5.8,6.7 12,0.5 23.5,12 12,23.5 5.8,17.3"/></svg></a>
    <div class="intro absolute left-18 top-anchor-intro z-2 w-240"><span class="hi mb-4 block font-sans text-md font-medium leading-body text-ink">Hi, I’m Jan Pilik.</span><h1 class="font-sans text-xl font-bold leading-heading tracking-snug text-balance">I build large&#8209;scale software products end to end</h1><span class="skills mt-6 block w-264 whitespace-nowrap font-sans text-sm font-normal leading-solid tracking-slight text-ink-muted">Design<i class="px-2 not-italic text-ink-muted opacity-55">·</i>Architecture<i class="px-2 not-italic text-ink-muted opacity-55">·</i>Full stack<i class="px-2 not-italic text-ink-muted opacity-55">·</i>Tests &amp; CI/CD</span></div>

    <!-- 3 Title strip -->
    <div class="strip absolute inset-x-0 top-anchor-strip z-2 flex h-55.2 flex-col justify-center gap-4.5 bg-surface-sink/80 px-18 font-mono">
      <div class="top flex items-center justify-start gap-7"><div class="site text-base font-semibold leading-tight tracking-wide text-ink">SANGLOGIUM.COM</div><div class="kind text-sm tracking-none text-ink-muted">E-commerce app</div><a class="cta ml-auto inline-flex items-center gap-2 font-mono text-xs font-semibold leading-solid tracking-wider text-amber transition-filter hover:drop-shadow-glow-cta focus-visible:drop-shadow-glow-cta focus-visible:outline-none" href="#live"><span>LIVE</span><svg class="nd2 -my-3 h-14 w-14 flex-none overflow-visible fill-none stroke-current stroke-1 stroke-join-miter [&_*]:svg-vector-fixed" viewBox="0 0 24 24" aria-hidden="true"><defs><clipPath id="cc"><polygon points="5.8,6.7 12,0.5 23.5,12 12,23.5 5.8,17.3"/></clipPath><filter id="cb" x="-30%" y="-60%" width="160%" height="220%"><feGaussianBlur stdDeviation=".7"/></filter><mask id="cm" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24"><rect width="24" height="24" fill="#fff"/><rect x="6.8" y="9" width="10.6" height="6" rx="3" fill="#000" filter="url(#cb)"/></mask></defs><g class="kg fill-current stroke-none font-mono opacity-55" clip-path="url(#cc)" mask="url(#cm)" font-size="2.6" text-anchor="middle"><text y="1.8" opacity="0.3"><tspan x="8.2" dy="0">ナ</tspan><tspan x="8.2" dy="2.9">コ</tspan><tspan x="8.2" dy="2.9">ハ</tspan><tspan x="8.2" dy="2.9">レ</tspan><tspan x="8.2" dy="2.9">エ</tspan><tspan x="8.2" dy="2.9">オ</tspan><tspan x="8.2" dy="2.9">モ</tspan><tspan x="8.2" dy="2.9">キ</tspan></text><text y="1.8" opacity="0.55"><tspan x="10.4" dy="0">ネ</tspan><tspan x="10.4" dy="2.9">ヨ</tspan><tspan x="10.4" dy="2.9">エ</tspan><tspan x="10.4" dy="2.9">シ</tspan><tspan x="10.4" dy="2.9">キ</tspan><tspan x="10.4" dy="2.9">ク</tspan><tspan x="10.4" dy="2.9">ル</tspan><tspan x="10.4" dy="2.9">ス</tspan></text><text y="1.8" opacity="0.8"><tspan x="12.6" dy="0">ウ</tspan><tspan x="12.6" dy="2.9">カ</tspan><tspan x="12.6" dy="2.9">サ</tspan><tspan x="12.6" dy="2.9">セ</tspan><tspan x="12.6" dy="2.9">ヲ</tspan><tspan x="12.6" dy="2.9">ム</tspan><tspan x="12.6" dy="2.9">ヤ</tspan><tspan x="12.6" dy="2.9">ユ</tspan></text><text y="1.8" opacity="0.55"><tspan x="14.8" dy="0">ケ</tspan><tspan x="14.8" dy="2.9">ソ</tspan><tspan x="14.8" dy="2.9">タ</tspan><tspan x="14.8" dy="2.9">テ</tspan><tspan x="14.8" dy="2.9">ト</tspan><tspan x="14.8" dy="2.9">ヒ</tspan><tspan x="14.8" dy="2.9">フ</tspan><tspan x="14.8" dy="2.9">ヘ</tspan></text><text y="1.8" opacity="0.3"><tspan x="17.0" dy="0">ワ</tspan><tspan x="17.0" dy="2.9">ヌ</tspan><tspan x="17.0" dy="2.9">ノ</tspan><tspan x="17.0" dy="2.9">ミ</tspan><tspan x="17.0" dy="2.9">メ</tspan><tspan x="17.0" dy="2.9">リ</tspan><tspan x="17.0" dy="2.9">ロ</tspan><tspan x="17.0" dy="2.9">ン</tspan></text></g><polyline points="8,4.5 12,0.5 17.9,6.4"/><polyline points="20.3,8.8 23.5,12 17.2,18.3"/><polyline points="15.7,19.8 12,23.5 5.8,17.3"/><path d="M8.2 12H16M13.4 9.6L16 12L13.4 14.4"/></svg></a></div>
      <a class="stats grid grid-cols-stats justify-between" href="https://github.com/munrhalls/sanglogium">
        <div><b class="block text-lg font-semibold leading-tight text-ink-soft">1</b><span class="mt-1.5 block whitespace-nowrap text-sm tracking-none text-ink-muted">Engineer</span></div>
        <div><b class="block text-lg font-semibold leading-tight text-ink-soft">24</b><span class="mt-1.5 block whitespace-nowrap text-sm tracking-none text-ink-muted">Months</span></div>
        <div><b class="block text-lg font-semibold leading-tight text-ink-soft">17</b><span class="mt-1.5 block whitespace-nowrap text-sm tracking-none text-ink-muted">Features</span></div>
        <div><b class="block text-lg font-semibold leading-tight text-ink-soft">650+</b><span class="mt-1.5 block whitespace-nowrap text-sm tracking-none text-ink-muted">Products</span></div>
      </a>
    </div>

    <!-- 5 Movie -->
    <div class="movie absolute left-18 top-anchor-movie z-2 h-anchor-movie-h w-264 overflow-hidden rounded-sm border border-solid border-line bg-surface-sink" role="img" aria-label="Autoplaying muted showcase video of sanglogium.com">
      <video class="absolute left-0 top-0 block h-anchor-video w-full object-cover" muted autoplay loop playsinline preload="metadata" src="/movie.webm"></video>
      <div class="bar absolute inset-x-0 bottom-15 h-2.5 bg-line-track"><i class="block h-full w-0 bg-ink motion-reduce:w-progress-still"></i></div>
      <div class="ctl absolute inset-x-0 bottom-0 flex h-15 items-center justify-between bg-surface-sink/85 px-7">
        <span class="time font-mono text-2xs font-medium leading-solid text-ink-muted tabular-nums">0:00 / 0:00</span>
        <svg class="h-9 w-9 fill-none stroke-ink-muted stroke-1.4 stroke-cap-round stroke-join-round" viewBox="0 0 12 12" aria-label="Muted"><path d="M1.5 4.5H3.5L6 2.5V9.5L3.5 7.5H1.5Z"/><path d="M8 4.5L11 7.5M11 4.5L8 7.5"/></svg>
      </div>
    </div>

    <!-- 6 Buttons -->
    <nav class="btns absolute left-0 top-anchor-nav z-4 h-74 w-300" aria-label="Sections">
      <a class="btn absolute flex h-20 items-center gap-5 bg-cloud pl-9 font-mono text-sm font-semibold leading-solid tracking-none whitespace-nowrap text-ink transition-color hover:text-amber focus-visible:text-amber focus-visible:outline-none left-124 top-8" href="#features">Features<svg class="nd -mb-7.5 h-16 w-16 flex-none self-end overflow-visible fill-none stroke-current stroke-1 stroke-join-miter [&_*]:svg-vector-fixed" viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="nr0" gradientUnits="userSpaceOnUse" x1="-101.6" y1="0" x2="8.2" y2="0"><stop offset="0" stop-color="currentColor" stop-opacity="0"/><stop offset="1" stop-color="currentColor"/></linearGradient><clipPath id="nc0"><polygon points="5.8,6.7 12,0.5 23.5,12 12,23.5 5.8,17.3"/></clipPath><filter id="nb0" x="-30%" y="-60%" width="160%" height="220%"><feGaussianBlur stdDeviation=".7"/></filter><mask id="nm0" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24"><rect width="24" height="24" fill="#fff"/><rect x="6.8" y="9" width="10.6" height="6" rx="3" fill="#000" filter="url(#nb0)"/></mask></defs><g class="kg fill-current stroke-none font-mono opacity-55" clip-path="url(#nc0)" mask="url(#nm0)" font-size="2.6" text-anchor="middle"><text y="1.8" opacity="0.3"><tspan x="8.2" dy="0">ナ</tspan><tspan x="8.2" dy="2.9">コ</tspan><tspan x="8.2" dy="2.9">ハ</tspan><tspan x="8.2" dy="2.9">レ</tspan><tspan x="8.2" dy="2.9">エ</tspan><tspan x="8.2" dy="2.9">オ</tspan><tspan x="8.2" dy="2.9">モ</tspan><tspan x="8.2" dy="2.9">キ</tspan></text><text y="1.8" opacity="0.55"><tspan x="10.4" dy="0">ネ</tspan><tspan x="10.4" dy="2.9">ヨ</tspan><tspan x="10.4" dy="2.9">エ</tspan><tspan x="10.4" dy="2.9">シ</tspan><tspan x="10.4" dy="2.9">キ</tspan><tspan x="10.4" dy="2.9">ク</tspan><tspan x="10.4" dy="2.9">ル</tspan><tspan x="10.4" dy="2.9">ス</tspan></text><text y="1.8" opacity="0.8"><tspan x="12.6" dy="0">ウ</tspan><tspan x="12.6" dy="2.9">カ</tspan><tspan x="12.6" dy="2.9">サ</tspan><tspan x="12.6" dy="2.9">セ</tspan