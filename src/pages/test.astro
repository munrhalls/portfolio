<script is:inline>
  // Progress bar + time readout follow the real video.
  (function () {
    var v = document.querySelector('.movie video'), f = document.querySelector('.bar i'), t = document.querySelector('.time');
    function m(n) { return Math.floor(n / 60) + ':' + String(Math.floor(n % 60)).padStart(2, '0'); }
    function u() {
      var d = v.duration;
      if (!d || !isFinite(d)) return;
      f.style.width = (v.currentTime / d * 100) + '%';
      t.textContent = m(v.currentTime) + ' / ' + m(d);
    }
    v.addEventListener('timeupdate', u);
    v.addEventListener('loadedmetadata', u);
  })();
</script>
