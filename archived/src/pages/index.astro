---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionBreak from '../components/SectionBreak.astro';
import MovieHero from '../components/MovieHero.astro';
import CaseStudies from '../components/CaseStudies.astro';
import SkillsClusters from '../components/SkillsClusters.astro';
import Journey from '../components/Journey.astro';
import Story from '../components/Story.astro';
import Terminal from '../components/Terminal.astro';
---

<Base title="MUNRHALLS -- Full-Stack Developer">
  <Header slot="nav" />

  <MovieHero />

  <SectionBreak index="01 / 04" title="Case Studies" />
  <CaseStudies />

  <SectionBreak index="02 / 04" title="Skills" />
  <SkillsClusters />

  <SectionBreak index="03 / 04" title="Journey" />
  <Journey />

  <SectionBreak index="04 / 04" title="Story" />
  <Story />

  <Terminal />

  <Footer slot="footer" />
</Base>
