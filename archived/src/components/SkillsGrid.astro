---
interface Props {
  technologies: string[];
}

const { technologies } = Astro.props;
---

<div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-3">
  {technologies.map((tech) => (
    <span class="rounded-lg border border-outline-variant bg-surface-container-low px-3 py-1 text-sm text-center text-on-surface-variant">{tech}</span>
  ))}
</div>
