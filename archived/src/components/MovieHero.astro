---
import CodeDiamond from './CodeDiamond.astro';
---

<section id="movie" class="relative min-h-dvh flex flex-col justify-center overflow-hidden">
  <CodeDiamond />
  <div class="max-w-container mx-auto px-5 lg:px-16 w-full">

    <div class="relative aspect-video w-full border border-outline-variant rounded overflow-hidden bg-surface-container-low flex flex-col items-center justify-center gap-4">
      <a href="#case-studies" class="t-c1 t-c1-gold absolute top-3 right-3" data-skip>SKIP &rarr;</a>
      <svg class="w-10 h-10 text-primary mx-auto" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><polygon points="8,1 15,8 8,15 1,8"/></svg>
      <p class="font-mono text-label-mono text-on-surface uppercase tracking-widest">SANGLOGIUM</p>
      <p class="font-mono text-label-mono text-on-surface-variant uppercase">THE MOVIE &middot; 50S &middot; PLACEHOLDER</p>
      <button type="button" id="movie-play" class="border border-outline-variant rounded-full w-12 h-12 flex items-center justify-center text-on-surface" aria-label="Play the movie">&#9654;</button>
      <p id="movie-note" class="hidden font-mono text-label-mono text-tertiary uppercase">MOVIE IN PRODUCTION &mdash; THIS FRAME IS A PLACEHOLDER</p>
    </div>

    <div class="flex flex-col gap-4 mt-8">
      <p class="t-c1 t-c1-gold">JAN PILIK &middot; FULL-STACK DEVELOPER</p>
      <h1 class="t-d1">I built Sanglogium &mdash; alone, in production.</h1>
      <p class="t-b1 max-w-xl">Design system, Stripe checkout, multi-carrier shipping, Sanity CMS &mdash; every layer built solo across 20+ months.</p>
      <a href="#case-studies" class="t-c1 inline-flex items-center gap-2" data-skip>SEE THE PROOF <span aria-hidden="true">&darr;</span></a>
    </div>

  </div>
</section>

<script is:inline>
  (function () {
    function setupMovie() {
      var section = document.getElementById('movie');
      var play = document.getElementById('movie-play');
      var note = document.getElementById('movie-note');
      if (!section || !play || !note) return;
      if (play.dataset.movieInit === 'true') return;
      play.dataset.movieInit = 'true';

      var skipped = false;
      section.querySelectorAll('[data-skip]').forEach(function (a) {
        a.addEventListener('click', function () { skipped = true; });
      });

      play.addEventListener('click', function () {
        var showing = !note.classList.contains('hidden');
        if (skipped && !showing) {
          section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        note.classList.toggle('hidden');
        play.innerHTML = showing ? '&#9654;' : '&#8545;';
      });
    }

    document.addEventListener('astro:page-load', setupMovie);
    setupMovie();
  })();
</script>
